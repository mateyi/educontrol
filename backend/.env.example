# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Base de datos (SQLite local / PostgreSQL en producción Neon o Railway)
# Local: "file:./dev.db"
# Producción: "postgresql://usuario:password@host:5432/educontrol?schema=public"
DATABASE_URL="file:./dev.db"

# Seguridad y Autenticación JWT
JWT_SECRET="educontrol-jwt-super-secret-key-laboratorio-software-2026"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"
